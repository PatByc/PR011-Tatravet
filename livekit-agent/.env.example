# Set real values only in Railway Variables or an ignored local .env.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PR011_UPSTASH_VECTOR_REST_URL=
PR011_UPSTASH_VECTOR_REST_TOKEN=
PR011_LIVEKIT_VARIANT=gpt-live-client
# Set for production SIP report delivery; browser rooms are excluded.
LIVEKIT_EOCR_URL=
LIVEKIT_EOCR_SECRET=
# Set true only on an isolated test worker and dashboard database.
LIVEKIT_EOCR_INCLUDE_BROWSER=false
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PYTHONUNBUFFERED=1
